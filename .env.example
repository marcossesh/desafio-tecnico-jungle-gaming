# Para rodar fora do Docker (bun run dev). No compose, os valores vêm do docker-compose.yml.

# --- App ---
PORT=3000
ROLES=api,consumer,outbox,scheduler
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=25000

# --- PostgreSQL ---
# a aplicação usa o role restrito (sem UPDATE/DELETE no ledger); migrations rodam como dono do schema
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering
MIGRATION_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
APP_DB_PASSWORD=wagering_app
DB_POOL_MAX=10
WALLET_LOCK_TIMEOUT_MS=3000

# --- SQS (MiniStack) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_MAX_ATTEMPTS=5
SQS_RETRY_BASE_SECONDS=2

# --- Outbox publisher ---
OUTBOX_TICK_MS=500
OUTBOX_LEASE_MS=30000

# --- Worker de PENDING_REFERENCE ---
PENDING_REF_TICK_MS=1000
PENDING_REF_BASE_MS=2000
PENDING_REF_CAP_MS=300000
PENDING_REF_MAX_ATTEMPTS=10

# --- Auth (`keycloak` exige o IdP: docker compose --profile auth up -d keycloak) ---
AUTH_MODE=none
AUTH_ISSUER=http://localhost:8080/realms/wagering
AUTH_AUDIENCE=wagering-api
